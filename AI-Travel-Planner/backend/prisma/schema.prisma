generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  DRAFT
  PLANNING
  READY
  FAILED
}

enum ActivitySource {
  LLM
  USER_EDIT
  SYSTEM
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  homeLocation String?
  currency     String          @default("INR")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  trips        Trip[]
  preferences  UserPreference?
}

model UserPreference {
  id          String  @id @default(cuid())
  userId      String  @unique
  interests   String  @default("[]")
  dietary     String  @default("[]")
  pace        String  @default("balanced")
  hotelType   String?
  transport   String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trip {
  id             String            @id @default(cuid())
  userId         String
  title          String
  origin         String?
  startDate      DateTime
  endDate        DateTime
  travelerCount  Int
  budget         Float
  currency       String            @default("INR")
  status         TripStatus        @default(DRAFT)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences    TripPreference?
  destinations   TripDestination[]
  itineraries    Itinerary[]
  savedTrips     SavedTrip[]
}

model TripPreference {
  id          String @id @default(cuid())
  tripId      String @unique
  interests   String @default("[]")
  dietary     String  @default("[]")
  pace        String @default("balanced")
  hotelType   String?
  transport   String?
  freeText    String?
  trip        Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripDestination {
  id         String @id @default(cuid())
  tripId     String
  name       String
  lat        Float?
  lng        Float?
  orderIndex Int
  trip       Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, orderIndex])
}

model Itinerary {
  id          String          @id @default(cuid())
  tripId      String
  version     Int             @default(1)
  status      String          @default("DRAFT")
  generatedAt DateTime        @default(now())
  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  days        ItineraryDay[]
}

model ItineraryDay {
  id          String      @id @default(cuid())
  itineraryId String
  dayNumber   Int
  date        DateTime
  summary     String?
  itinerary   Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  activities  Activity[]

  @@unique([itineraryId, dayNumber])
}

model Activity {
  id             String         @id @default(cuid())
  itineraryDayId String
  placeId        String?
  name           String
  category       String
  startTime      DateTime
  endTime        DateTime
  estimatedCost  Float          @default(0)
  notes          String?
  orderIndex     Int
  source         ActivitySource @default(LLM)
  lat            Float?
  lng            Float?
  openingHours   String?
  itineraryDay   ItineraryDay  @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  place          Place?        @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([itineraryDayId, orderIndex])
}

model Place {
  id              String     @id @default(cuid())
  externalPlaceId String?    @unique
  name            String
  category        String
  lat             Float
  lng             Float
  openingHours    String?
  rating          Float?
  priceLevel      Int?
  activities      Activity[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model SavedTrip {
  id        String   @id @default(cuid())
  tripId    String
  name      String
  snapshot  String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model ApiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  provider  String
  response  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([provider, expiresAt])
}
